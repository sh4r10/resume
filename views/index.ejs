<!Doctype html>
<html>
    <head>
        <link rel="stylesheet" href="./styles/styles.css">
        <link rel="stylesheet" href="./styles/fonts.css">
        <link rel="stylesheet" href="./styles/misc.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    </head>
    <body class="mx-auto bg-gray-100" style="max-width: 1200px">
        <div class="mx-auto mt-4 flex items-center justify-center">
            <img class="w-24 h-24 rounded-full" src=<%= basics.image %> alt="Shariq Shahbaz"/>
            <div class="ml-4">
                <h1 class="font-light text-3xl text-center"><%= basics.name.split(" ")[0] %> <span class="font-medium"><%= basics.name.split(" ")[1] %></span></h1>
                <p class="tracking-wider text-lg text-center mt-0.5">Full-stack
            Engineer</p>
            </div>
        </div>
        <div class="mx-auto mt-2 text-2xl text-center text-emerald-700 flex items-center justify-center gap-4">
            <a target="_blank" href="tel:<%= basics.phone %>" class="flex items-end">
                <i class="fa-solid fa-phone"></i>
                <span class="text-black font-regular text-sm ml-2"><%= basics.phone %></span>
            </a>
            <a target="_blank" href="mailto:<%= basics.email %>" class="flex items-end">
                <i class="fa-solid fa-envelope"></i>
                <span class="text-black font-regular text-sm ml-2"><%= basics.email %></span>
            </a>
            <% basics.profiles.forEach(profile => { %>
            <a target="_blank" href=<%= profile.url %> class="flex items-end">
                <i class="<%= profile.icon %>"></i>
                <span class="text-black font-regular text-sm ml-2"><%= profile.username %></span>
            </a>
            <% }) %>
        </div>
        <hr style="border-color: #047857" class="mt-4 opacity-35" />
        <div class="mt-4 flex">
            <div class="w-3/4 pr-4">
                <div class="mt-4 mb-10">
                    <h2 class="font-bold text-2xl mb-4 ">SKILLS</h2>
                    <% skills.forEach(skill => { %>
                    <div class="mb-3">
                        <p class="font-bold text-base"><%=
                            skill.name.toUpperCase() %><span class="font-normal ml-3"><%= skill.keywords.join(" • ") %></span></p>
                    </div>
                    <% }) %>
                </div>
                <div class="mt-4 mb-10">
                    <h2 class="font-bold text-2xl mb-4">EXPERIENCE</h2>
                    <% work.forEach(exp => { %>
                    <div class="mb-4">
                        <h3 class="font-bold text-lg mb-1">
                            <% if(exp.url == ""){ %>
                               <span class="cursor-default"><%=
                                exp.name.toUpperCase() %></span>
                             <% } else{ %>  
                            <a href=<%= exp.url %> target="_blank"
                                class="underline decoration-4
                                decoration-emerald-700/75"><%=
                                exp.name.toUpperCase()
                                %></a>
                            <% } %>
                            <span class="mx-2 text-gray-500/75">|</span>
                            <span class="text-gray-700"><%= exp.highlights.join(" • ") %></span></h3>
                        <p class="font-normal text-md text-gray-900 mb-1">
                            <span clasS="font-semibold"><%= exp.position %></span>
                            <span class="mx-2 text-gray-500/75">|</span>
                            <%= exp.startDate %> - <%= exp.endDate %>
                            <span class="mx-2 text-gray-500/75">|</span>
                            <%= exp.location %>
                        </p>
                        <ul class="pl-4 list-disc list-outside">
                            <% exp.points.forEach(point => { %>
                                <li class="pt-1"><%- point %></li>
                            <% }) %>
                        </ul>
                    </div>
                    <% }) %>
                </div>
            </div>
            <div class="w-1/4">
                <div class="mt-4 mb-12">
                    <h2 class="font-bold text-2xl mb-4">EDUCATION</h2>
                    <% education.forEach(edu => { %>
                    <div class="mb-4">
                        <p class="text-sm font-bold text-emerald-800"><%= edu.studyType %></p>
                        <h3 class="mb-1 font-semibold text-base"><%= edu.area %></h3>
                        <h4 class="mb-1 text-sm font-normal"><%= edu.institution %></h4>
                        <p class="mb-1 text-gray-500 text-sm font-semibold"><%= edu.startDate %> - <%= edu.endDate %></p>
                    </div>
                    <% }) %>
                </div>
                <div class="mt-4 mb-12">
                    <h2 class="font-bold text-2xl mb-4">CERTIFICATIONS</h2>
                    <% certificates.forEach(cert => { %>
                    <div class="mb-4 font-bold">
                            <a href=<%= cert.url %> target="_blank"
                                class="underline decoration-4
                                decoration-emerald-700/75 text-base"><%=
                                cert.name.toUpperCase()
                                %></a>
                        <h4 class="font-medium mt-1"><%= cert.issuer %></h4>
                        <p class="text-gray-500 font-semibold"><%= cert.date %></p>
                    </div>
                    <% }) %>
                </div>
                <div class="mt-4 mb-12">
                    <h2 class="font-bold text-2xl mb-2">LANGUAGES</h2>
                    <% languages.forEach(lang => { %>
                    <p class="mb-1 font-medium"><%= lang.language %></p>
                    <% }) %>
                </div>
                <!-- <div class="mt-5"> -->
                <!--     <h2 class="font-bold text-xl mb-2">Interests</h2> -->
                <!--     <% interests.forEach(interest => { %> -->
                <!--     <div class="mb-1"> -->
                <!--         <p class="font-medium"><%= interest.name %></p> -->
                <!--         <p class="text-gray-800 text-sm"><%= interest.keywords.join(" • ") %></p> -->
                <!--     </div> -->
                <!--     <% }) %> -->
                <!-- </div> -->
                <div class="mt-4 mb-12">
                    <h2 class="font-bold text-2xl mb-2">REFERENCES</h2>
                    <% references.forEach(reference => { %>
                    <div class="mb-1">
                        <p class="font-medium text-lg"><%= reference.name %></p>
                        <p class="text-gray-800 text-base"><%= reference.position %></p>
                        <a target="_blank" href="mailto:<%= reference.contact %>" class="text-emerald-700 flex items-end">
                            <i class="fa-solid fa-envelope"></i>
                            <span class="text-black font-regular text-sm ml-2"><%= reference.contact %></span>
                        </a>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>
        <div class="mt-3 break-before-page">
            <h2 class="font-bold text-2xl mb-4">PROJECTS</h2>
            <% projects.forEach(project => { %>
            <div class="mb-4">
                <div class="mb-1">
                    <a href=<%= project.url %> target="_blank"
                                class="underline decoration-4
                                decoration-emerald-700/75 text-base font-bold"><%=
                                project.name.toUpperCase()
                                %></a>
                    <span class="mx-2 text-gray-500/75">|</span>
                    <span class="text-black text-base font-medium"><%= project.highlights.join(" • ") %></span>
                </div>
                <p class="text-black"><%= project.description %></p>
            </div>
            <% }) %>
        </div>
    </body>
</html>
